{
  "manifest_version": 2,
  "name": "xNxP Tabs",
  "version": "1.0",
  "description": "Tab manager for Firefox. Shows first opened and last active time for each tab.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["tabs", "storage"],
  "browser_action": {
    "default_title": "xNxP Tabs",
    "default_popup": "popup.html"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "applications": {
    "gecko": {
      "id": "xnxp-tabs@gl00ten.net"
    }
  }
}
