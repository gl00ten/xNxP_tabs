{
  "manifest_version": 2,
  "name": "xNxP Tabs",
  "version": "1.1",
  "description": "Friendly tab manager with search, sorting, tab age, and quick tab switching.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "96": "icons/icon96.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["tabs", "storage"],
  "browser_action": {
    "default_title": "xNxP Tabs",
    "default_popup": "popup.html"
  },
  "commands": {
    "_execute_browser_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+U",
        "mac": "Command+Shift+U"
      },
      "description": "Open xNxP Tabs popup"
    }
  },
  "background": {
    "scripts": ["browser-polyfill.js", "background.js"],
    "persistent": false
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "xnxp-tabs@gl00ten.net",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
