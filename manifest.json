{
  "manifest_version": 3,
  "name": "xNxP Tabs",
  "version": "1.1.38",
  "description": "ADHD friendly tab manager: search open tabs, unload to free memory, close duplicates, last opened age. Default shortcut Ctrl+Shift+U (Cmd+Shift+U on Mac). Pin the icon so it stays visible.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "64": "icons/icon64.png",
    "96": "icons/icon96.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "tabs",
    "storage"
  ],
  "action": {
    "default_title": "xNxP Tabs (Ctrl+Shift+U), pin to keep icon visible",
    "default_popup": "popup.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+U",
        "mac": "Command+Shift+U"
      },
      "description": "Open xNxP Tabs popup"
    }
  },
  "background": {
    "scripts": [
      "browser-polyfill.js",
      "lib/core.js",
      "background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "xnxp-tabs@gl00ten.net",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      },
      "strict_min_version": "115.0"
    }
  }
}
