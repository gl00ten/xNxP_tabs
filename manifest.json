{
  "manifest_version": 2,
  "name": "xNxP Tabs",
  "version": "1.1.23",
  "description": "ADHD friendly tab manager with search, sorting, and tab age. Default shortcut: Ctrl+Shift+U (Cmd+Shift+U on Mac). Pin the extension so the toolbar icon stays visible.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "96": "icons/icon96.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["tabs", "storage"],
  "browser_action": {
    "default_title": "xNxP Tabs (Ctrl+Shift+U), pin to keep icon visible",
    "default_popup": "popup.html"
  },
  "commands": {
    "_execute_browser_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+U",
        "mac": "Command+Shift+U"
      },
      "description": "Open xNxP Tabs popup"
    }
  },
  "background": {
    "scripts": ["browser-polyfill.js", "background.js"],
    "persistent": false
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "xnxp-tabs@gl00ten.net",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
